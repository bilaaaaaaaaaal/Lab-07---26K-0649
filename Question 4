#include <stdio.h>
int main(){
    int greenhouse [3][3][3];
    int temp,z1=0,z2=0,z3=0,avg1,avg2,avg3,maxX=0,maxY=0,maxZ=0;
    for(int x=0;x<3;x++){
        for(int y=0;y<3;y++){
            for(int z=0;z<3;z++){
                printf("enter temperature of point x:%d y:%d z:%d\n",x,y,z);
                scanf("%d",&temp);
                greenhouse[x][y][z]=temp;
            }
        }
    }
    int max=greenhouse[0][0][0];
    for(int z=0;z<3;z++){
        for(int x=0;x<3;x++){
            for(int y=0;y<3;y++){
                if(z==0){
                    z1+=greenhouse[x][y][z];
                }
                else if(z==1){
                    z2+=greenhouse[x][y][z];
                }
                else{
                    z3+=greenhouse[x][y][z];
                }
            }
        }
    }
    avg1=z1/9;
    avg2=z2/9;
    avg3=z3/9;
    printf("average of layer 1:%d\naverage of layer 2:%d\naverage of layer 3:%d\n",avg1,avg2,avg3);
    if(avg1>avg2){
        if(avg1>avg3){
            printf("layer 1 has greatest average temperature of %d",avg1);
        }
        else{
            printf("layer 3 has greatest average temperature of %d",avg3);
        }
    }
    else{
        if(avg2>avg3){
            printf("layer 2 has greatest average temperature of %d",avg2);
        }
        else{
            printf("layer 3 has the greatest average temperature of %d",avg3);
        }
    }
    for(int x=0;x<3;x++){
        for(int y=0;y<3;y++){
            for(int z=0;z<3;z++){
                if(greenhouse[x][y][z]>max){
                    max = greenhouse[x][y][z];
                    maxX=x;
                    maxY=y;
                    maxZ=z;
                }
            }
        }
    }
    printf("greatest temperature is %d, at the coordinates %d %d %d",max,maxX,maxY,maxZ);
}
