#include <stdio.h>
int main(){
    int sudoku[3][3],input,invalid=0,current;
    for(int i=0;i<3;i++){
        for(int j=0;j<3;j++){
            printf("enter a number between 1-9, 0 to leave empty\n");
            scanf("%d",&input);
            sudoku[i][j]=input;
        }
    }
    for(int i=0;i<3;i++){
        for(int j=0;j<3;j++){
            if(sudoku[i][j]>9 || sudoku[i][j]<0){
                invalid=1;
            }
        }
    }
    for(int i=0;i<3;i++){
        for(int j=0;j<3;j++){
            current=sudoku[i][j];
            for(int k=0;k<3;k++){
                for(int l=0;l<3;l++){
                    if (i!=k || j!=l){
                        if (sudoku[k][l]==current && sudoku[k][l]!=0){
                            invalid=1;}}
                }
            }
        }
    }
    if(invalid==1){
        printf("invalid grid");
    }
    else{
        printf("valid grid");
    }
}
