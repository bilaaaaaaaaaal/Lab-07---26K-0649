#include <stdio.h>
int main(){
    int index;
    float salesdata[4][5];
    float input,max=0,etotal[4]={0,0,0,0},ptotal[5]={0,0,0,0,0};
    for(int i=0;i<4;i++){
        for(int j=0;j<5;j++){
            printf("enter sales figure of product %d for salesman %d",j+1,i+1);
            scanf("%d",&input);
            salesdata[i][j]=input;
            switch (i)
            {
            case 0:
            etotal[0]+=input;
            break;
            case 1:
            etotal[1]+=input;
            break;
            case 2:
            etotal[2]+=input;
            break;
            case 3:
            etotal[3]+=input;
            break;
            default:
            printf("if this prints there is an error");
            break;
            }
            switch (j)
            {
            case 0:
            ptotal[0]+=input;
            break;
            case 1:
            ptotal[1]+=input;
            break;
            case 2:
            ptotal[2]+=input;
            break;
            case 3:
            ptotal[3]+=input;
            break;
            case 4:
            ptotal[4]+=input;
            break;
            default:
            printf("if this prints there is an error");
            break;
            }
        }

        printf("total sales per employee:\n");
        for(int i=0;i<4;i++){
            printf("%d. ",i+1);
            printf("%.02f",etotal[i]);
            printf("\n");
        }

        printf("total sales per product:\n");
        for(int i=0;i<5;i++){
            printf("%d. ",i+1);
            printf("%.02f",ptotal[i]);
            printf("\n");
        }
        
        for(int i=0;i<5;i++){
            if(ptotal[i]>max){
                max=ptotal[i];
                index = i+1;
            }
        }
        printf("highest revenue was generated by product %d \n",i);

        for(int i=0;i<4;i++){
            if(etotal[i]>10000){
                etotal[i]=etotal[i] + ((etotal[i]*10)/100);
                printf("total is %.02f, bonus was applied.\n",etotal[i]);
            }
            else{
                printf("total is %.02f, bonus was not applied.\n",etotal[i]);
            }
        }

        printf("total sales per employee after bonus:\n");
        for(int i=0;i<4;i++){
            printf("%d. ",i+1);
            printf("%.02f",etotal[i]);
            printf("\n");
        }
    }
}
